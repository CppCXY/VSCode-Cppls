{
  "name": "cppls",
  "displayName": "Cpp Language Server",
  "description": "C/C++ language support powered by the cppls language server.",
  "version": "0.1.1",
  "author": "CppCXY",
  "publisher": "CppCXY",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/CppCXY/VSCode-Cppls.git"
  },
  "bugs": {
    "url": "https://github.com/CppCXY/VSCode-Cppls/issues"
  },
  "homepage": "https://github.com/CppCXY/VSCode-Cppls#readme",
  "engines": {
    "vscode": "^1.138.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The language server is spawned as a separate process from `server/cpp_ls`, which is an executable reached through `cppls.server.path`. In an untrusted workspace the extension only starts the bundled server and never runs a path from the workspace settings."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "cpp_ls needs a real file system to index the workspace."
    }
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "c",
    "cpp",
    "c++",
    "language server",
    "lsp"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:cuda-cpp",
    "onLanguage:cuda"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cppls.restartServer",
        "title": "Restart Language Server",
        "category": "cppls"
      },
      {
        "command": "cppls.stopServer",
        "title": "Stop Language Server",
        "category": "cppls"
      },
      {
        "command": "cppls.showLogs",
        "title": "Show Logs",
        "category": "cppls"
      },
      {
        "command": "cppls.showServerInfo",
        "title": "Show Server Info",
        "category": "cppls"
      },
      {
        "command": "cppls.checkDevServer",
        "title": "Check Development Server Port",
        "category": "cppls"
      }
    ],
    "languages": [
      {
        "id": "c",
        "aliases": [
          "C",
          "c"
        ],
        "extensions": [
          ".c",
          ".i"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "cpp",
        "aliases": [
          "C++",
          "Cpp",
          "cpp"
        ],
        "extensions": [
          ".cpp",
          ".cppm",
          ".cc",
          ".ccm",
          ".cxx",
          ".cxxm",
          ".c++",
          ".c++m",
          ".hpp",
          ".hh",
          ".hxx",
          ".h++",
          ".h",
          ".ii",
          ".ino",
          ".inl",
          ".ipp",
          ".ixx",
          ".mpp",
          ".mxx",
          ".tpp",
          ".txx",
          ".hpp.in",
          ".h.in"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "cuda-cpp",
        "aliases": [
          "CUDA C++"
        ],
        "extensions": [
          ".cu",
          ".cuh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "formatSpecifier",
        "description": "Style for the specification of a format field: `{:.3f}` in `std::format`, `%-8.2` in `printf`."
      },
      {
        "id": "formatArgument",
        "description": "Style for the argument a format field refers to: `{0}`, `{name}`, `%1$`, `*`."
      },
      {
        "id": "formatConversion",
        "description": "Style for the letter that decides how a value is written: `d`, `s`, `f`, `[a-z]`."
      },
      {
        "id": "formatEscape",
        "description": "Style for an escaped brace or percent: `{{`, `}}`, `%%`."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "c",
        "scopes": {
          "formatSpecifier": [ "keyword.other" ],
          "formatArgument": [ "variable.parameter" ],
          "formatConversion": [ "constant.numeric" ],
          "formatEscape": [ "constant.character.escape" ]
        }
      },
      {
        "language": "cpp",
        "scopes": {
          "formatSpecifier": [ "keyword.other" ],
          "formatArgument": [ "variable.parameter" ],
          "formatConversion": [ "constant.numeric" ],
          "formatEscape": [ "constant.character.escape" ]
        }
      },
      {
        "language": "cuda-cpp",
        "scopes": {
          "formatSpecifier": [ "keyword.other" ],
          "formatArgument": [ "variable.parameter" ],
          "formatConversion": [ "constant.numeric" ],
          "formatEscape": [ "constant.character.escape" ]
        }
      }
    ],
    "grammars": [
      {
        "language": "c",
        "scopeName": "source.c",
        "path": "./syntaxes/c.tmLanguage.json"
      },
      {
        "language": "cpp",
        "scopeName": "source.cpp.embedded.macro",
        "path": "./syntaxes/cpp.embedded.macro.tmLanguage.json"
      },
      {
        "language": "cpp",
        "scopeName": "source.cpp",
        "path": "./syntaxes/cpp.tmLanguage.json"
      },
      {
        "language": "cuda-cpp",
        "scopeName": "source.cuda-cpp",
        "path": "./syntaxes/cuda-cpp.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Cpp Language Server",
      "properties": {
        "cppls.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `cpp_ls` executable. Relative paths are resolved against the extension root. When empty the bundled `server/cpp_ls` is used."
        },
        "cppls.server.launchMode": {
          "type": "string",
          "enum": [
            "auto",
            "tcp",
            "bundled"
          ],
          "enumDescriptions": [
            "Use TCP while the CPPLS_DEV environment variable is set and a server is listening on the configured port; otherwise spawn the server executable (recommended).",
            "Always connect over TCP. Fails if nothing is listening on the port.",
            "Always spawn the server executable over stdio, ignoring CPPLS_DEV."
          ],
          "default": "auto",
          "markdownDescription": "How the language server is reached. `auto` connects over TCP when the `CPPLS_DEV` environment variable is set and port `cppls.server.port` answers, and otherwise spawns the server over stdio."
        },
        "cppls.server.port": {
          "type": "number",
          "default": 5009,
          "minimum": 1,
          "maximum": 65535,
          "scope": "machine-overridable",
          "markdownDescription": "TCP port of the development language server. Overridden by the `CPPLS_DEV_PORT` environment variable."
        },
        "cppls.server.connectTimeout": {
          "type": "number",
          "default": 5000,
          "minimum": 200,
          "markdownDescription": "Milliseconds to wait for the TCP development server to accept a connection before falling back to a spawned server."
        },
        "cppls.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra command line arguments passed to the spawned language server."
        },
        "cppls.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "markdownDescription": "Traces the communication between VS Code and the cppls language server."
        },
        "cppls.revealOutputChannelOnActivate": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Reveal the `cppls` output channel as soon as the language server starts."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check-types": "tsc -p ./ --noEmit",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js --sourcemap",
    "bundle:watch": "npm run bundle -- --watch",
    "package": "npm run check-types && npm run bundle",
    "lint": "eslint src",
    "pretest": "npm run compile && npm run package && npm run lint && npm run verify:manifest",
    "test": "vscode-test",
    "test:unit": "npm run compile && node --test \"test/unit/**/*.test.mjs\"",
    "verify:server": "node scripts/verify-server.mjs",
    "verify:bundle": "node scripts/check-bundle.mjs",
    "verify:manifest": "node scripts/check-manifest.mjs",
    "vsix": "npm run package && vsce package --no-dependencies --out cppls.vsix",
    "install:local": "npm run vsix && code --install-extension cppls.vsix --force"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vscode-jsonrpc": "^9.0.3",
    "vscode-languageclient": "^10.1.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
