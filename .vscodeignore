# Files that must never end up in the published extension.
#
# The shipped extension is `dist/extension.js` (esbuild bundles every runtime
# dependency into it) plus the language contribution, the documentation and the
# server binaries. Everything else is development only.

# Development tooling and sources
.vscode/**
.vscode-test/**
.github/**
src/**
test/**
scripts/**
docs/**
out/**
node_modules/**
*.vsix
.editorconfig
.gitignore
.gitattributes
.yarnrc
vsc-extension-quickstart.md
**/tsconfig.json
**/eslint.config.mjs
**/*.map
**/*.ts
**/.vscode-test.*

# Server: ship the binary and the contract doc only.
server/README.md
server/build/**
server/CMakeFiles/**
server/CMakeCache.txt

# Artefacts produced by running the language server against this repository
# (index summaries, caches, logs). These are rewritten at runtime and have no
# business being packaged.
.cppls/**
**/.cppls/**
*.log

# Staging area of scripts/download-server.mjs (downloaded archives and
# extractions). A release build leaves nothing here, but a local one does,
# and 30 MB of binaries is not something an extension should ship twice.
temp/**
